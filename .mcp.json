{
  "mcpServers": {
    "villeneuve-herbeth": {
      "type": "stdio",
      "command": "bun",
      "args": ["run", "src/index.ts"],
      "env": {
        "MCP_TRANSPORT": "stdio"
      }
    },
    "coolify": {
      "command": "bunx",
      "args": ["-y", "@masonator/coolify-mcp"],
      "env": {
        "COOLIFY_BASE_URL": "http://192.168.1.10:8000"
      }
    }
  }
}
