# Stdio transport (single-user, local) reads credentials from these vars.
# HTTP transport ignores them — each caller sends their own Herbeth login
# via HTTP Basic auth.
HERBETH_USERNAME=your-extranet-login
HERBETH_PASSWORD=your-extranet-password

# Transport: "stdio" (default, for local MCP clients like Claude Desktop / Claude Code)
# or "http" (multi-user; each request must carry Basic auth with the caller's
# own Herbeth credentials).
# MCP_TRANSPORT=stdio

# HTTP server bind (defaults: 0.0.0.0:3000)
# PORT=3000
# HOST=0.0.0.0

# Optional: directory where download_file saves files when no path arg is given (stdio mode).
# HERBETH_DOWNLOAD_DIR=/Users/you/Downloads/herbeth

# Optional: force download_file to always return base64 instead of writing to disk.
# Useful in HTTP mode where the client can't see the server filesystem.
# MCP_DOWNLOAD_RETURN_BASE64=1

# Optional: path to the SQLite database used to store user-curated document metadata
# (corrected titles, suppliers, amounts, tags, notes). Created if missing.
# Default: ./data/metadata.db (Docker image default: /app/data/metadata.db on the volume)
# HERBETH_METADATA_DB=./data/metadata.db
